<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Smart Community Service Platform</display-name>

    <filter>
        <filter-name>exceptionHandlingFilter</filter-name>
        <filter-class>com.label.community.filter.ExceptionHandlingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>exceptionHandlingFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>characterEncodingFilter</filter-name>
        <filter-class>com.label.community.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>characterEncodingFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>corsFilter</filter-name>
        <filter-class>com.label.community.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>corsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>jwtAuthenticationFilter</filter-name>
        <filter-class>com.label.community.filter.JwtAuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>jwtAuthenticationFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>roleAuthorizationFilter</filter-name>
        <filter-class>com.label.community.filter.RoleAuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>roleAuthorizationFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>dataEncryptionFilter</filter-name>
        <filter-class>com.label.community.filter.DataEncryptionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>dataEncryptionFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>requestLogFilter</filter-name>
        <filter-class>com.label.community.filter.RequestLogFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>requestLogFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

</web-app>
